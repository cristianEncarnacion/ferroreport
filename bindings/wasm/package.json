{
  "name": "ferroreport",
  "version": "1.4.0",
  "description": "Report engine and JasperReports alternative for Node.js, Deno, Bun and browsers: reads JasperReports JRXML templates without a JVM and writes PDF, Excel (XLSX), Word (DOCX), PowerPoint (PPTX), OpenDocument (ODS, ODT), CSV and HTML in milliseconds, pixel-identical to JasperReports. Safe with untrusted templates.",
  "license": "MIT OR Apache-2.0",
  "author": "Cristian Encarnacion",
  "homepage": "https://cristianencarnacion.github.io/ferroreport/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cristianEncarnacion/ferroreport.git",
    "directory": "bindings/wasm"
  },
  "bugs": "https://github.com/cristianEncarnacion/ferroreport/issues",
  "keywords": ["jasperreports", "jasperreports alternative", "jrxml", "jrxml to pdf", "pdf", "excel", "xlsx", "docx", "pptx", "ods", "odt", "csv", "report", "reporting", "invoice", "pdf-generation", "charts", "qrcode", "wasm", "fast"],
  "main": "./node/ferroreport.js",
  "types": "./node/ferroreport.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./node/ferroreport.d.ts",
        "default": "./node/ferroreport.js"
      },
      "default": {
        "types": "./web/ferroreport.d.ts",
        "default": "./web/ferroreport.js"
      }
    }
  },
  "files": ["node/", "web/", "README.md", "LICENSE-MIT", "LICENSE-APACHE"],
  "sideEffects": false,
  "engines": { "node": ">=18" }
}
